# Golden Dome SOC Backend Environment Configuration

# Application
APP_NAME="Golden Dome SOC API"
APP_VERSION="0.3.0"
DEBUG=false
ENVIRONMENT=development

# Security
SECRET_KEY=replace-with-a-256-bit-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (comma separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/goldendome

# Redis
REDIS_URL=redis://redis:6379/0

# Wazuh API
WAZUH_API_URL=https://localhost:55000
WAZUH_API_USERNAME=wazuh
WAZUH_API_PASSWORD=wazuh
WAZUH_API_VERIFY_SSL=false
WAZUH_API_TIMEOUT=30

# OpenSearch / Wazuh Indexer
OPENSEARCH_URL=https://localhost:9200
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=admin
OPENSEARCH_VERIFY_SSL=false

# AI / Local LLM (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_TIMEOUT=120
AI_FALLBACK_ENABLED=true

# Threat Intelligence APIs (free tiers; leave blank to skip external lookups)
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=
ALIENVAULT_OTX_API_KEY=
URLHAUS_API_URL=https://urlhaus-api.abuse.ch/v1
CISA_KEV_URL=https://api.cisa.gov/known-exploited-vulnerabilities/catalog
TI_CACHE_HOURS=24

# Risk Scoring Weights (must sum to 1.0)
RISK_WEIGHT_SEVERITY=0.30
RISK_WEIGHT_CRITICALITY=0.20
RISK_WEIGHT_VULNERABILITY=0.20
RISK_WEIGHT_THREAT_INTEL=0.15
RISK_WEIGHT_HISTORICAL=0.15

# Logging
LOG_LEVEL=INFO
