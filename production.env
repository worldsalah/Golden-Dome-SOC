# Golden Dome SOC — Production Environment
# Copy this file to .env and update before running install.sh

# ------------------------------------------------------------------
# Platform identity
# ------------------------------------------------------------------
GOLDENDOME_HOSTNAME=192.168.1.50
SECRET_KEY=change-me-to-a-random-64-char-hex-string
ENVIRONMENT=production
DEBUG=false

# ------------------------------------------------------------------
# Database
# ------------------------------------------------------------------
POSTGRES_DB=goldendome
POSTGRES_USER=goldendome
POSTGRES_PASSWORD=change-me-strong-postgres-password

# ------------------------------------------------------------------
# Cache
# ------------------------------------------------------------------
REDIS_PASSWORD=change-me-strong-redis-password

# ------------------------------------------------------------------
# External connectors (optional on first boot)
# ------------------------------------------------------------------
WAZUH_API_URL=https://wazuh-manager:55000
WAZUH_API_USERNAME=wazuh
WAZUH_API_PASSWORD=wazuh
WAZUH_INDEXER_URL=https://wazuh-indexer:9200
WAZUH_INDEXER_USERNAME=admin
WAZUH_INDEXER_PASSWORD=change-me
OPENSEARCH_URL=https://wazuh-indexer:9200
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# ------------------------------------------------------------------
# AI / Local LLM
# ------------------------------------------------------------------
AI_PROVIDER=ollama

# ------------------------------------------------------------------
# Email / Notifications
# ------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@goldendome.local
