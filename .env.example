# Deployment
COMPOSE_PROJECT_NAME=golden-dome-soc
HTTP_PORT=8080
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# Database
POSTGRES_DB=goldendome
POSTGRES_USER=goldendome
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql+asyncpg://goldendome:replace-with-a-long-random-password@db:5432/goldendome

# Cache
REDIS_PASSWORD=replace-with-a-long-random-password
REDIS_URL=redis://:replace-with-a-long-random-password@redis:6379/0

# Authentication
SECRET_KEY=replace-with-a-64-character-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-before-production
ALLOW_BOOTSTRAP_REGISTRATION=false
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# Browser security
ALLOWED_ORIGINS=http://localhost:8080
TRUSTED_HOSTS=localhost,127.0.0.1

# AI
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_TIMEOUT=45
AI_FALLBACK_ENABLED=true

# Wazuh (enable with: docker compose --profile wazuh up -d)
WAZUH_API_URL=https://wazuh-manager:55000
WAZUH_API_USERNAME=wazuh-wui
WAZUH_API_PASSWORD=change-me
WAZUH_INDEXER_USERNAME=admin
WAZUH_INDEXER_PASSWORD=change-me
WAZUH_API_VERIFY_SSL=true
OPENSEARCH_URL=https://wazuh-indexer:9200
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=change-me
OPENSEARCH_VERIFY_SSL=true

# Integrations
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=
ALIENVAULT_OTX_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
SMTP_FROM=soc@example.com
SOAR_AUTO_TRIGGER_ENABLED=true

# Demo data is seeded by default
SEED_DEMO_DATA=true
